// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  objectives    Objective[]
  entries       Entry[]
  
  // NUEVAS RELACIONES PARA MYYEAR
  diaryEntries  DiaryEntry[]
  mediaEntries  MediaEntry[]
  dailyScores   DailyScore[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ============================================
// HÁBITOS/OBJETIVOS (ACTUALIZADOS)
// ============================================

model Objective {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  type        String    // 'boolean', 'number', 'time'
  target      Float?    // Meta opcional (ej: 10000 pasos)
  unit        String?   // Unidad opcional (ej: 'pasos', 'km', 'min')
  color       String    @default("#6366f1")
  icon        String    @default("🎯")
  startDate   DateTime? // Fecha de inicio del objetivo
  endDate     DateTime? // Fecha de fin del objetivo
  active      Boolean   @default(true) // Si está activo o archivado
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries Entry[]

  @@index([userId])
  @@index([userId, active])
}

model Entry {
  id          String   @id @default(cuid())
  userId      String
  objectiveId String
  date        DateTime
  value       Float    // Valor registrado
  note        String?  // Nota opcional
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, date])
  @@index([userId, date])
}

// ============================================
// NUEVAS TABLAS PARA MYYEAR
// ============================================

// Entrada de diario personal
model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // Fecha del día (sin hora, normalizada a 00:00)
  content   String   @db.Text
  mood      String?  // "great", "good", "neutral", "bad", "terrible"
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@index([userId, date])
}

// Media consumido (series, películas, libros)
model MediaEntry {
  id        String    @id @default(cuid())
  userId    String
  date      DateTime  // Fecha en que se consumió
  type      MediaType
  title     String
  season    Int?      // Solo para series
  episode   Int?      // Solo para series
  pages     Int?      // Solo para libros
  rating    Int?      // 1-5 estrellas
  notes     String?   @db.Text
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, date])
  @@index([userId, type])
}

enum MediaType {
  series
  movie
  book
  manga
  anime
  podcast
  videogame
  documentary
}

// Score calculado por día
model DailyScore {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime // Fecha del día (sin hora)
  score       Int      // 0-100
  habitsScore Int      @default(0) // Puntos de hábitos (max 40)
  diaryScore  Int      @default(0) // Puntos de diario (max 30)
  mediaScore  Int      @default(0) // Puntos de media (max 20)
  activityScore Int    @default(0) // Puntos de actividad (max 10) - futuro
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@index([userId, date])
}